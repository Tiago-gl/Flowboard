generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DB_CONNECTION")
}

model User {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  email        String           @unique
  passwordHash String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  layout       DashboardLayout?
  goals        Goal[]
  habits       Habit[]
  habitLogs    HabitLog[]
  tasks        Task[]

  @@index([createdAt])
}

model Task {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String       @db.Uuid
  title       String
  description String?
  status      TaskStatus   @default(A_FAZER)
  priority    TaskPriority @default(MEDIA)
  dueDate     DateTime?
  sortOrder   Int          @default(0)
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, dueDate])
}

model Habit {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String         @db.Uuid
  name          String
  frequency     HabitFrequency
  targetPerWeek Int?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs          HabitLog[]

  @@index([userId, frequency])
}

model HabitLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  habitId   String   @db.Uuid
  userId    String   @db.Uuid
  date      DateTime
  count     Int      @default(1)
  createdAt DateTime @default(now())
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@index([userId, date])
}

model Goal {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String     @db.Uuid
  title        String
  targetValue  Int
  currentValue Int        @default(0)
  unit         String
  weekStart    DateTime
  status       GoalStatus @default(ATIVA)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, weekStart])
}

model DashboardLayout {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @unique @db.Uuid
  layoutJson String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum TaskStatus {
  A_FAZER
  EM_ANDAMENTO
  FEITO
}

enum TaskPriority {
  BAIXA
  MEDIA
  ALTA
}

enum HabitFrequency {
  DIARIA
  SEMANAL
}

enum GoalStatus {
  ATIVA
  CONCLUIDA
}
